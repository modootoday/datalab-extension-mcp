{
  "name": "datalab-extension-mcp-repo",
  "private": true,
  "workspaces": [
    "mcp",
    "mcp-core",
    "mcp-server",
    "mcp-installer"
  ],
  "overrides": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-deep-equal": "3.1.3",
    "fast-uri": "3.1.8",
    "json-schema-traverse": "1.0.0",
    "zod": "4.5.4",
    "zod-to-json-schema": "3.25.2"
  },
  "scripts": {
    "test": "npm run test --workspaces",
    "build": "npm run build --workspace mcp-core && npm run build --workspace mcp-server && npm run build --workspace mcp-installer && npm run build --workspace mcp"
  }
}
